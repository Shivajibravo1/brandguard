# Copy to .env and fill in. Values for the local demo come from `npx supabase@3.1.0 status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL_FROM_DOCKER=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
SMTP_HOST_FROM_DOCKER=host.docker.internal
SMTP_PORT=54325
ALERT_EMAIL_TO=soc-team@tenant-a.brandguard.test
ALERT_EMAIL_FROM=alerts@brandguard.test
ALERT_MIN_SCORE=60
# Lookalike domain scanner (Docker service name, reachable from N8N)
SCANNER_URL=http://scanner:8080
# Shared secret N8N sends to the scanner (generate a long random value)
SCANNER_TOKEN=
# Optional DNS servers for the scanner (blank = Docker resolver), e.g. 1.1.1.1,8.8.8.8
SCANNER_NAMESERVERS=
